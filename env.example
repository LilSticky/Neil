# Neil's settings. Copy to .env (git-ignored) and fill in; on Wispbyte, enter them in the panel.
DISCORD_TOKEN=bot-token-from-the-developer-portal
DISCORD_APPLICATION_ID=000000000000000000
DISCORD_GUILD_ID=000000000000000000
# Role IDs of the Officers: Moderator and King (who may use /quota)
DISCORD_MODERATOR_ROLE_ID=000000000000000000
DISCORD_KING_ROLE_ID=000000000000000000
# Channel IDs: the text channel where Onboarding Interview threads are opened, and the text channel for Neil's log
DISCORD_ONBOARDING_CHANNEL_ID=000000000000000000
DISCORD_LOG_CHANNEL_ID=000000000000000000
# Minutes an Onboarding Interview may stay silent before it is abandoned; whole number, at least 1 (default 1440)
# INTERVIEW_TIMEOUT_MINUTES=1440
DATA_DIR=./data
LAP_TRACKER_API_KEY=some-api-key
# Minutes a looked-up player stays cached; whole number, at least 10 (default 10)
GAME_API_CACHE_MINUTES=10
# Game API requests kept back for Onboarding Interviews: lookups stop when this many or fewer are left;
# whole number, at least 0 (default 100)
# GAME_API_QUOTA_RESERVE=100

# From slice 002 (not required yet)
HOME_KINGDOM=330
