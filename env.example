# Neil's settings. Copy to .env (git-ignored) and fill in; on Wispbyte, enter them in the panel.
DISCORD_TOKEN=bot-token-from-the-developer-portal
DISCORD_APPLICATION_ID=000000000000000000
DISCORD_GUILD_ID=000000000000000000
# Role IDs of the Officers: Moderator and King (who may use /quota)
DISCORD_MODERATOR_ROLE_ID=000000000000000000
DISCORD_KING_ROLE_ID=000000000000000000
# Channel IDs: the text channel where Onboarding Interview threads are opened, and the text channel for Neil's log
DISCORD_ONBOARDING_CHANNEL_ID=000000000000000000
DISCORD_LOG_CHANNEL_ID=000000000000000000
# Optional channel ID of the guides forum: named in the guides line of the Preferences message (without it, the line says "the guides forum")
# DISCORD_GUIDES_FORUM_ID=000000000000000000
# Minutes an Onboarding Interview may stay silent before it is abandoned; whole number from 1 to 525600 (default 1440)
# INTERVIEW_TIMEOUT_MINUTES=1440
DATA_DIR=./data
LAP_TRACKER_API_KEY=some-api-key
# Minutes a looked-up player stays cached; whole number, at least 10 (default 10)
GAME_API_CACHE_MINUTES=10
# Game API requests kept back for Onboarding Interviews: lookups stop when this many or fewer are left;
# whole number, at least 0 (default 100)
# GAME_API_QUOTA_RESERVE=100

# The Home Kingdom: the Kingdom this server is for; whole number from 1 to 9999 (required)
HOME_KINGDOM=330
# First level of each Troop Bracket T1…T10: up to 10 whole numbers of at least 1, strictly increasing (default 1,3,6,10,14,17,20,24,27,30)
# TROOP_BRACKET_LEVELS=1,3,6,10,14,17,20,24,27,30
# UTC hour (0–23) at which the Daily Sync runs each day (default 3, that is 03:00 UTC)
# SYNC_HOUR_UTC=3
# Game API requests the Daily Sync may use per day; it never uses the Quota Reserve; whole number, at least 1 (default 500)
# SYNC_SHARE=500

# Plan the Raid (slice 034). Unset DISCORD_WAR_COUNCIL_ROLE_ID: Raid planning is off and the RAID_ settings are not needed.
# The War Council role: its holders draft, publish and cancel the Battle Plan with /raid-plan; a Discord ID
# DISCORD_WAR_COUNCIL_ROLE_ID=000000000000000000
# The Raid's start on Saturday, HH:MM from 00:00 to 23:59 in Server Time (UTC-2); required once the War Council role is set
# RAID_START=20:00
# The Plan Deadline: whole hours before the Raid start, 1 to 144 (default 24); more than RAID_CONFIRMATION_DEADLINE_HOURS
# RAID_PLAN_DEADLINE_HOURS=24
# The Confirmation Deadline: whole hours before the Raid start, 0 to 143 (default 2); fewer than RAID_PLAN_DEADLINE_HOURS
# RAID_CONFIRMATION_DEADLINE_HOURS=2

# Neil Police, the read-only test bot (documentation/NEIL-POLICE.md, ADR 15). Neil ignores these; Wispbyte never needs them.
# NEIL_POLICE_TOKEN=police-bot-token
# Servers the MCP server may read, comma-separated: the test server only
# NEIL_POLICE_GUILD_IDS=000000000000000000
# Optional: the MCP toolsets (default discovery,messages,members,roles,permissions,forums,scheduled_events,stats,moderation)
# NEIL_POLICE_TOOLSETS=discovery,messages
# Optional: Police's role; the setup script lets it see every closed channel, only on a server in NEIL_POLICE_GUILD_IDS
# NEIL_POLICE_ROLE_ID=000000000000000000
